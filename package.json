{
  "name": "discord-bot-template",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/bot.ts",
    "dev": "bun --watch src/bot.ts",
    "build": "bun build ./src/bot.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,jsonc,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,jsonc,md}\"",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/ws": "^2.0.4",
    "discord-api-types": "^0.38.57"
  }
}
